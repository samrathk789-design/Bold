PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# Emergency debug only — do not enable when real SMS/email delivery works
EXPOSE_OTP_IN_RESPONSE=false
# Optional: enable real Google Sign-In verification
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173

# Email OTP — prefer Resend; otherwise SMTP
RESEND_API_KEY=
EMAIL_FROM=Bold <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Twilio SMS (preferred) — required for reliable phone OTP delivery
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender, e.g. +15551234567
TWILIO_FROM_NUMBER=

# Optional TextBelt fallback when Twilio is not configured
# https://textbelt.com/
TEXTBELT_KEY=

# Bold Brain (OpenRouter) — never commit the real key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
