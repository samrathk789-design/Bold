PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# In development, OTP is returned in API responses for easy testing
EXPOSE_OTP_IN_RESPONSE=true
# Optional: enable real Google Sign-In verification
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173
